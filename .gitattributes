* text=auto

# 텍스트 — 줄바꿈을 LF로 통일 (엑셀이 저장한 CRLF도 커밋 시 정규화)
*.md   text eol=lf
*.csv  text eol=lf
*.json text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.yml  text eol=lf

# 바이너리 — 정규화·diff 금지
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
