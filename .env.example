# 이 파일을 복사해서 `.env` 를 만들어 사용한다.
# `.env` 는 .gitignore 에 등록돼 있으며 절대 커밋하지 않는다.
# 저장소가 공개(public)라 키가 커밋되면 즉시 유출된다.

# ─────────────────────────────────────────────────────────────
# 엔딩 기록문 생성 LLM (DEC-CONTENT-011)
# ─────────────────────────────────────────────────────────────
# 서버리스 함수(api/)에서만 읽는다. VITE_ 접두어를 붙이면 브라우저 번들에
# 포함되어 유출되므로 절대 붙이지 않는다.
# 값이 비어 있으면 "사용할 수 없는 LLM 환경"으로 처리되어
# 각 엔딩의 fallback_record_text 를 사용한다. (기획서상 정상 경로)
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# 빌드 모드
# ─────────────────────────────────────────────────────────────
# dev        : 개발 빌드. 공포도 수치와 데이터 검증 오류를 화면에 표시
#              (DEC-RESIDENT-047, DEC-UI-024)
# submission : 제출 빌드. 위 개발용 표시를 모두 숨김
VITE_BUILD_MODE=dev
