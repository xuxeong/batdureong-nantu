{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* api/ 의 서버리스 함수는 process.env 를 읽는다.
       브라우저 코드(src/)에서는 process.env 를 쓰지 않는다 — Vite 는 import.meta.env 다. */
    "types": ["node"]
  },
  "include": ["src/**/*", "tools/**/*", "api/**/*"]
}
